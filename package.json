{
  "name": "@ponsfamily/jay",
  "version": "1.0.0",
  "description": "Customer support automation for @Ljayx069, the Pons Family support account on X.",
  "license": "MIT",
  "author": "Pons Family",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jay": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js run",
    "dev": "tsx src/index.ts run --dry-run",
    "once": "tsx src/index.ts once",
    "chat": "tsx src/index.ts chat",
    "eval": "tsx scripts/eval.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "better-sqlite3": "13.0.3",
    "pino": "10.3.1",
    "twitter-api-v2": "1.29.1",
    "viem": "2.56.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.19.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
