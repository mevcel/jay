# Jay environment configuration. Copy to .env and fill in.
# Every secret here belongs to the @Ljayx069 app on developer.x.com and the
# Pons Family model API workspace. Never commit a filled-in copy.

# ---- Model API ---------------------------------------------------------------
JAY_API_KEY=
# low | medium | high | xhigh | max. Support replies do well at medium.
JAY_EFFORT=medium

# ---- X (Twitter) API, OAuth 1.0a user context for @Ljayx069 -----------------
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Numeric user id of @Ljayx069 (resolved automatically when blank).
X_USER_ID=
# Handle Jay posts as, without the @.
X_HANDLE=Ljayx069
# Answer direct messages too (requires DM scope on the X app).
X_ENABLE_DMS=true

# ---- Runtime -----------------------------------------------------------------
# Seconds between polls. X Basic tier allows ~10 mention reads / 15 min.
POLL_INTERVAL_SECONDS=120
# When true, Jay drafts and logs replies but never posts.
DRY_RUN=true
# Hard cap on public replies per rolling hour (spam-safety).
MAX_REPLIES_PER_HOUR=40
# Ignore mentions older than this on cold start.
MAX_MENTION_AGE_MINUTES=180
DATABASE_PATH=./data/jay.db
LOG_LEVEL=info

# ---- Robinhood Chain ---------------------------------------------------------
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BLOCKSCOUT_API_URL=https://robinhoodchain.blockscout.com/api/v2

# ---- Human escalation --------------------------------------------------------
# Discord or Slack incoming-webhook URL that pings the human support team.
ESCALATION_WEBHOOK_URL=
# Handle(s) of the human rep(s) Jay hands off to, comma-separated.
HUMAN_HANDOFF_HANDLES=ponsdotfamily
